#!/usr/bin/env bash

# Temporarily not caring about referenced variables that are not assigned here.
# shellcheck disable=2154

# SC2015: You can often see that I use: A && B || C as if-then-else.
# This is generally not correct, if A is true but B is false, C will run.
# But it's safe to use when B is just a variable definition or a command that is never false.

set -eo pipefail

MAIS_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)" || exit 1
readonly MAIS_ROOT

# BEGIN MAIS MODULE LOADER
# Bootstrap the module loader.
# shellcheck source=lib/core/loader.sh
source "$MAIS_ROOT/lib/core/loader.sh"

mais_load_module "lib/core/config.sh"
mais_load_module "lib/core/log.sh"
mais_load_module "lib/core/validate.sh"

mais_load_module "lib/ui/text.sh"
mais_load_module "lib/ui/tui.sh"
mais_load_module "lib/ui/ui.sh"

mais_load_module "lib/core/prompt.sh"
mais_load_module "lib/core/run.sh"
mais_load_module "lib/core/sudo.sh"

mais_load_module "lib/distro/detect.sh"
mais_load_module "lib/distro/arch.sh"

mais_load_module "lib/cli/help.sh"
mais_load_module "lib/cli/parser.sh"
mais_load_module "lib/cli/dispatch.sh"

mais_load_module "lib/commands/arch-install.sh"
mais_load_module "lib/commands/backup.sh"
mais_load_module "lib/commands/update-mirrors.sh"
mais_load_module "lib/commands/install-dotfiles.sh"
mais_load_module "lib/commands/install-aurhelper.sh"
mais_load_module "lib/commands/install-programs.sh"

# Load configuration functions before the configure command
mais_load_module "lib/commands/configure/grub.sh"
mais_load_module "lib/commands/configure/pacman.sh"
mais_load_module "lib/commands/configure/makepkg.sh"
mais_load_module "lib/commands/configure/proxychains.sh"
mais_load_module "lib/commands/configure/keyd.sh"

mais_load_module "lib/commands/configure.sh"

mais_load_module "lib/commands/experimental-clean-home.sh"
mais_load_module "lib/commands/install.sh"
# END MAIS MODULE LOADER

### Handling arguments ###

parse_arguments "$@"
resolve_runtime_defaults
dispatch_commands
